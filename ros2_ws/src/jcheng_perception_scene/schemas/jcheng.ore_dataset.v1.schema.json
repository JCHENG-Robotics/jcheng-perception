{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/jcheng.ore_dataset.v1.schema.json",
  "title": "JCHENG ore dataset manifest v1",
  "description": "Internal offline dataset manifest. It records provenance and visible instance label maps; it is not a cross-repo contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "source", "annotation_method",
    "license", "created_at", "scenes"
  ],
  "properties": {
    "schema_version": {"const": "jcheng.ore_dataset.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["synthetic", "public", "recorded"]},
    "annotation_method": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "citation": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "generator": {"type": "object"},
    "original_annotations": {"type": ["string", "null"]},
    "original_annotations_sha256": {"type": ["string", "null"]},
    "skipped_crowd_annotations": {"type": "integer", "minimum": 0},
    "skipped_images": {"type": "array", "items": {"type": "string"}},
    "category_names": {"type": "array", "items": {"type": "string"}},
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id", "image", "mask", "width", "height",
          "timestamp_ns", "frame_id", "attributes", "instances"
        ],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "mask": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "timestamp_ns": {"type": "integer", "minimum": 0},
          "frame_id": {"type": "string"},
          "attributes": {"type": "object"},
          "image_sha256": {"type": ["string", "null"]},
          "mask_sha256": {"type": ["string", "null"]},
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "instance_id", "mask_index", "area_px", "bbox_xyxy",
                "stratum"
              ],
              "properties": {
                "instance_id": {"type": "string"},
                "mask_index": {"type": "integer", "minimum": 1},
                "area_px": {"type": "integer", "minimum": 0},
                "bbox_xyxy": {
                  "type": "array", "minItems": 4, "maxItems": 4,
                  "items": {"type": "integer", "minimum": 0}
                },
                "stratum": {"type": "string"},
                "category": {"type": "string"},
                "occlusion_ratio": {"type": ["number", "null"]},
                "contact_px": {"type": ["integer", "null"]},
                "contact_ratio": {"type": ["number", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
