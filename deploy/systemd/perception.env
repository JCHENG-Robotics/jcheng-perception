# Configuration for the JCHENG perception split stack (systemd).
#
# Installed to /etc/jcheng-perception/perception.env; the units read it with
# EnvironmentFile=- (a missing file is not an error; the wrapper defaults then
# apply).  Paths are inside the ArmPiUltra container, not on the host.
JCHENG_PERCEPTION_CONTAINER=ArmPiUltra
JCHENG_PERCEPTION_CONTAINER_USER=ubuntu
JCHENG_PERCEPTION_WS=/home/ubuntu/jcheng-perception/ros2_ws
# Vendor workspace: supplies ros_robot_controller_msgs for wrist_tf.
JCHENG_PERCEPTION_VENDOR_SETUP=/home/ubuntu/ros2_ws/install/setup.bash

# Optional per-run config overrides (defaults point at the installed
# share/jcheng_perception_edge/config files):
#JCHENG_PERCEPTION_CAMERAS_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/cameras.yaml
#JCHENG_PERCEPTION_FUSION_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/fusion_dual_hardware.yaml
#JCHENG_PERCEPTION_FRAMES_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/frames.yaml
#JCHENG_PERCEPTION_VIEW_BIAS_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/view_bias.yaml
#JCHENG_PERCEPTION_WRIST_TF_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/wrist_tf.yaml
#JCHENG_PERCEPTION_EXT_TF_CONFIG=/home/ubuntu/jcheng-perception/ros2_ws/install/jcheng_perception_edge/share/jcheng_perception_edge/config/ext_tf.yaml

# One RMW end-to-end: the camera drivers, gateway and GPU node all use
# CycloneDDS on domain 0.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/ubuntu/cyclonedds.xml
