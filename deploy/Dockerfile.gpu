# Perception GPU host image (laptop / Orin).
#
# The production `ultralytics` backend runs ROS 2 Jazzy here, matching the
# Jazzy host toolchain, so it no longer needs a separate host venv. Build it
# once:
#
#   docker build -f deploy/Dockerfile.gpu -t jcheng-perception-gpu:latest deploy
#
# Status: the Jazzy variant has not been rebuilt or GPU-verified yet; the
# existing local `jcheng-perception-gpu:latest` image was built from the Humble
# base. Running it with --gpus all requires nvidia-container-toolkit on the
# host; see deploy/README.md for the one-time host step and verification
# commands.
#
# The build downloads several GB of CUDA wheels (the verified host venv is
# 6.8 GB), so it is network-bound.
ARG ROS_BASE_IMAGE=ros:jazzy-ros-base@sha256:5147d3ae250ce754afd399f6bfec15b33dd4e473ca357e30432a3182031bfad6
FROM ${ROS_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Domestic mirrors, then the ROS foundations and the apt OpenCV build.
RUN set -eux; \
    grep -rlI 'packages.ros.org' /etc/apt 2>/dev/null \
        | xargs -r sed -i 's|packages.ros.org/ros2/ubuntu|mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu|g'; \
    grep -rlI 'archive.ubuntu.com' /etc/apt 2>/dev/null \
        | xargs -r sed -i 's|archive.ubuntu.com/ubuntu|mirrors.tuna.tsinghua.edu.cn/ubuntu|g'; \
    grep -rlI 'security.ubuntu.com' /etc/apt 2>/dev/null \
        | xargs -r sed -i 's|security.ubuntu.com/ubuntu|mirrors.tuna.tsinghua.edu.cn/ubuntu|g'; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-opencv \
        python3-pip \
        python3-setuptools \
        python3-venv \
        python3-yaml \
        ros-jazzy-ament-cmake \
        ros-jazzy-geometry-msgs \
        ros-jazzy-rmw-cyclonedds-cpp \
        ros-jazzy-rosidl-default-generators \
        ros-jazzy-rosidl-default-runtime \
        ros-jazzy-sensor-msgs \
        ros-jazzy-std-msgs; \
    rm -rf /var/lib/apt/lists/*

# Python 3.12 venv with system site packages, so rclpy and the message packages
# remain visible. Versions match the verified host venv
# (~/.venvs/jcheng-perception-gpu, 2026-11-24): torch 2.9.1+cu128,
# ultralytics 8.4.216, onnxruntime 1.32.0, openvino 2026.4.1, numpy 1.26.4.
#
# `opencv-python` is deliberately NOT installed and `ultralytics` is installed
# with --no-deps after its dependency list: the PyPI wheel would shadow the apt
# `python3-opencv` build, which is the one that carries ArUco. The tag backend
# and the YOLO backend must share the same cv2.
RUN python3 -m venv --system-site-packages /opt/jcheng/venv && \
    /opt/jcheng/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/jcheng/venv/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        'torch==2.9.1+cu128' 'torchvision==0.24.1+cu128' && \
    /opt/jcheng/venv/bin/pip install --no-cache-dir \
        'numpy==1.26.4' 'PyYAML==6.0.1' matplotlib pillow requests scipy \
        tqdm psutil py-cpuinfo pandas seaborn ultralytics-thop polars \
        'onnxruntime==1.32.0' 'openvino==2026.4.1' && \
    /opt/jcheng/venv/bin/pip install --no-cache-dir --no-deps \
        'ultralytics==8.4.216'

WORKDIR /workspace
